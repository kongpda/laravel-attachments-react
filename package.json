{
    "name": "@kongpda/laravel-attachments-react",
    "version": "0.2.0",
    "description": "React and Inertia-friendly UI for the Kongpda Laravel attachments ecosystem.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./sortable": {
            "import": {
                "types": "./dist/sortable.d.ts",
                "default": "./dist/sortable.js"
            },
            "require": {
                "types": "./dist/sortable.d.cts",
                "default": "./dist/sortable.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/sortable.tsx --format esm,cjs --dts",
        "dev": "tsup src/index.ts src/sortable.tsx --format esm,cjs --dts --watch",
        "check": "tsc --noEmit",
        "prepublishOnly": "bun run check && bun run test && bun run build",
        "test": "vitest run"
    },
    "peerDependencies": {
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2"
    },
    "devDependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "jsdom": "^30.1.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.16",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.6.0"
    },
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kongpda/laravel-attachments-react.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependenciesMeta": {
        "@dnd-kit/core": {
            "optional": true
        },
        "@dnd-kit/sortable": {
            "optional": true
        },
        "@dnd-kit/utilities": {
            "optional": true
        }
    }
}
